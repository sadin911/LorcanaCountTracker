# Build-time config for the deployed site. Committed on purpose.
#
# None of these are secrets. A Firebase web API key is public by design — it
# ships inside the JS bundle either way — and the R2 URL is a public endpoint.
# What actually protects the data is firestore.rules plus the Authentication
# authorized-domains list, not hiding these values. Committing them means the
# GitHub Pages deploy needs no repository secrets at all.
#
# .env.local still overrides these for `npm run dev`.
VITE_FIREBASE_API_KEY=AIzaSyDoAvESm5T8w7Pyk_1Rs8fEGFWD2mC8-dY
VITE_FIREBASE_AUTH_DOMAIN=lorcanacounttracker.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lorcanacounttracker
VITE_FIREBASE_STORAGE_BUCKET=lorcanacounttracker.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=719567253115
VITE_FIREBASE_APP_ID=1:719567253115:web:a21b33561dde4308c6bcde
VITE_R2_CDN_BASE=https://pub-106d2a10ead74810a7ea0e381ff1f0e1.r2.dev
VITE_GA_MEASUREMENT_ID=G-0NYFX1C10C
VITE_ADMIN_EMAILS=wingae911@gmail.com
