rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A binder is private to the signed-in user who owns it.
    match /users/{uid}/binders/{binderId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Decks are private to the signed-in user who owns them.
    match /users/{uid}/decks/{deckId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User's custom pricing per card
    match /users/{uid}/custom_prices/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Market prices are readable by all users, writable by authenticated users / admin
    match /market_prices/{cardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
