# Firebase web app config for the LorcanaCountTracker project.
# Copy to .env.local (gitignored) for local dev, and add the same values as
# GitHub Actions repository secrets for the Pages deploy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public base URL of the Cloudflare R2 bucket holding the card images.
# Leave blank in dev to serve them from public/ instead.
# Prefer a custom domain over Cloudflare's rate-limited pub-*.r2.dev endpoint.
VITE_R2_CDN_BASE=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Admin Console Secret Passkey
VITE_ADMIN_PASSKEY=

# Authorized Admin Google OAuth Emails (comma-separated, e.g. admin@example.com)
VITE_ADMIN_EMAILS=
